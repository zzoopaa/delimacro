;COORDS SETUP PROCESS
^u::{
	global home,bell
	MsgBox("This is the setup process for your inventory coordinates and necessary buttons. Please follow all of the steps carefully and make sure that your game window is set to the same size during setup as it will be during execution. Fullscreen or not will affect it as well.`n`nYou MUST dismiss or click OK on the text boxes before you press F8.","Zoopa's Deli Macro V" Version)
	
	MsgBox("First, open your inventory. Now hover your cursor over the top left corner of the very first slot in your inventory and press F8 after closing this text box.","Zoopa's Deli Macro V" Version)
	KeyWait "F8", "D"
	KeyWait "F8"
	MouseGetPos &x, &y
	firstx := x
	firsty := y

	MsgBox("Now hover your cursor over the bottom right corner of the very last slot in your inventory and press F8 after closing this text box.","Zoopa's Deli Macro V" Version)
	KeyWait "F8", "D"
	KeyWait "F8"
	MouseGetPos &x, &y
	secondx := x
	secondy := y
	if(!ParseInventory(firstx,firsty,secondx,secondy)){
		return
	}

	MsgBox("Now locate the home button. Hover your mouse cursor over the center of the home button and press F8 after closing this text box.","Zoopa's Deli Macro V" Version)
	KeyWait "F8", "D"
	KeyWait "F8"
	MouseGetPos &x, &y
	home := box(x-25,y-25,x+25,y+25)

	MsgBox("Now sit in the deli booth, go through the dialogue, hover your cursor over the center of the 'Ring Bell' popup and press F8 after closing this text box.","Zoopa's Deli Macro V" Version)
	KeyWait "F8", "D"
	KeyWait "F8"
	MouseGetPos &x, &y
	bell := box(x-50,y-25,x+50,y+25)
	WriteSettings()
	MsgBox("All set! You can check your coordinates with CTRL + J, the draw function.","Zoopa's Deli Macro V" Version)
}
;DRAW COORDINATES HOTKEY CTRL J
^j::{
