    	UIDisplay.Destroy()
		UIDisplay := ""
		return
	}
    UIDisplay := Gui("-DPIScale +AlwaysOnTop -Caption +ToolWindow +E0x20")
    UIDisplay.BackColor := "000000"
    UIDisplay.Show("x0 y0 w" A_ScreenWidth " h" A_ScreenHeight " NA")
    WinSetTransColor "000000", UIDisplay.Hwnd
    i := 1
	for box in boxes {
        DrawBox(UIDisplay, box.x1, box.y1, box.x2, box.y2, i)
		i++
    }
	DrawBox(UIDisplay,home.x1,home.y1,home.x2,home.y2,"Home")
	DrawBox(UIDisplay,bell.x1,bell.y1,bell.x2,bell.y2,"Ring Bell")
	return
}
