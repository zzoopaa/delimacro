;DRAWBOX FUNCTION
DrawBox(gui, x1, y1, x2, y2, label:="") {
    thickness := 2
    color := "FF0000"
    gui.Add("Text", "x" x1 " y" y1 " w" (x2-x1) " h" thickness " Background" color) ;top
    gui.Add("Text", "x" x1 " y" (y2-thickness) " w" (x2-x1) " h" thickness " Background" color) ;bottom
    gui.Add("Text", "x" x1 " y" y1 " w" thickness " h" (y2-y1) " Background" color) ;left
    gui.Add("Text", "x" (x2-thickness) " y" y1 " w" thickness " h" (y2-y1) " Background" color) ;right
	gui.Add("Text", "x" x1+5 " y" y1+5 " cWhite BackgroundTrans", label)
}

