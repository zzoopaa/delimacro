;BOX CLASS -----------------------------------------------------------------
class Box{
    __New(x1:=0, y1:=0, x2:=0, y2:=0)
    {
        this.x1 := x1
        this.y1 := y1
        this.x2 := x2
        this.y2 := y2
		this.ticked := false
		if (this.x1 = this.x2){
			this.real := false
		}
		else{
			this.real := true
		}
    }
}
;FUNCTIONS -----------------------------------------------------------------
;PARSE INVENTORY BOXES FUNCTION
ParseInventory(firstx,firsty,secondx,secondy){
	global boxes,invStr,invList
	boxWidth := (secondx-firstx)/5
	boxHeight := (secondy-firsty)/4
	boxes := []
	if(firstx>=secondx || firsty>=secondy){
		MsgBox("Invalid inventory coords! Try again.","Zoopa's Deli Macro V" Version)
		return false
	}
	invStr := firstx ',' firsty ',' secondx ',' secondy
	invList := [firstx,firsty,secondx,secondy]
	Loop 4{
		rIndex := A_Index-1
		Loop 5{
			cIndex := A_Index-1
			boxes.Push(box(firstx+boxWidth*cIndex,firsty+boxHeight*rIndex,firstx+boxWidth*cIndex+boxWidth,firsty+boxHeight*rIndex+boxHeight))
		}
	}
	return true
}
;READ SETTINGS FUNCTION
ReadSettings(){
	global settingsStr,home,bell,invList, KeepAnthony,KeepButter,KeepCentury,KeepChicken,KeepClever,KeepCourt,KeepCrown,KeepDrake,KeepGift,KeepKitchen,KeepMinion,KeepNoble,KeepPantry,KeepRed,KeepWhite,TakeScreenshots,WaitForDespawn,DoShortWaits
	settingsFile := A_ScriptDir "\ZDMsettings.txt"
	if (FileExist(settingsFile)){
		fileList := StrSplit(FileRead(settingsFile), "`n", "`r")
		if (StrLen(fileList[2])=settingsStrLen){
			settingsStr := fileList[2]
		}
		invList := StrSplit(fileList[3],",", "`r")
		if (invList.Length=4){
			ParseInventory(invList[1],invList[2],invList[3],invList[4])
		}
		homeList := StrSplit(fileList[4],",", "`r")
		if(homeList.Length=4){
			home := box(homeList[1],homeList[2],homeList[3],homeList[4])
		}
		bellList := StrSplit(fileList[5],",", "`r")
		if (bellList.Length=4){
			bell := box(bellList[1],bellList[2],bellList[3],bellList[4])
		}
	}

	KeepAnthony := (SubStr(settingsStr,1,1) = "1")
	KeepButter := (SubStr(settingsStr,2,1) = "1")
	KeepCentury := (SubStr(settingsStr,3,1) = "1")
	KeepChicken := (SubStr(settingsStr,4,1) = "1")
	KeepClever := (SubStr(settingsStr,5,1) = "1")
	KeepCourt := (SubStr(settingsStr,6,1) = "1")
	KeepCrown := (SubStr(settingsStr,7,1) = "1")
	KeepDrake := (SubStr(settingsStr,8,1) = "1")
	KeepGift := (SubStr(settingsStr,9,1) = "1")
	KeepKitchen := (SubStr(settingsStr,10,1) = "1")
	KeepMinion := (SubStr(settingsStr,11,1) = "1")
	KeepNoble := (SubStr(settingsStr,12,1) = "1")
	KeepPantry := (SubStr(settingsStr,13,1) = "1")
	KeepRed := (SubStr(settingsStr,14,1) = "1")
	KeepWhite := (SubStr(settingsStr,15,1) = "1")
	TakeScreenshots := (SubStr(settingsStr,16,1) = "1")
	WaitForDespawn := (SubStr(settingsStr,17,1) = "1")
	DoShortWaits := (SubStr(settingsStr,18,1) = "1")
}
;WRITE SETTINGS FUNCTION
WriteSettings(){
	global settingsStr,invStr,home,bell
	settingsFile := A_ScriptDir "\ZDMsettings.txt"
	if (FileExist(settingsFile)){
		FileDelete(settingsFile)
	}
	FileAppend("SETTING STRING | INV | HOME | BELL`n", settingsFile)
	FileAppend(settingsStr "`n", settingsFile)
	FileAppend(invStr '`n', settingsFile)
	FileAppend(home.x1 ',' home.y1 ',' home.x2 ',' home.y2 '`n', settingsFile)
	FileAppend(bell.x1 ',' bell.y1 ',' bell.x2 ',' bell.y2 '`n', settingsFile)
	FileAppend("DO NOT EDIT THIS FILE!", settingsFile)
}
;NATURAL MOUSE MOVEMENT FUNCTION
MouseNatural(){
	MouseMove 1, 2, 100, "R"
	MouseMove -2, -1, 100, "R"
	MouseMove 1, -1, 100, "R"
	MouseMove 1, -1, 100, "R"
	MouseMove -1, 1, 100, "R"
}
;DROP ITEM FUNCTION
DropItem(X1, Y1){
	MouseMove X1, Y1
	MouseNatural()
	Sleep 20
	MouseNatural()
	Sleep 20
	Click
	MouseNatural()
	Click
	Sleep 20
	MouseClick "right"
	Sleep 20
	MouseMove 25, 15, 100, "R"
	Sleep 20
	MouseNatural()
	Sleep 20
	MouseClick "left"
}
;IS THE INVENTORY OPEN CHECK FUNCTION
IsInvOpen(){
if (ColorListSearch(home.x1,home.y1,home.x2,home.y2,[0x8D807A],1)||ColorListSearch(home.x1,home.y1,home.x2,home.y2,[0x94C19B],1)){
	return true
}
else{
	return false
}
}
;PIXEL SEARCH LIST FUNCTION
ColorListSearch(X1,Y1,X2,Y2,ColorList,tolerance := colorTolerance){ ;Only returns true if all colors exist in the specific region
	for color in ColorList{
		if (PixelSearch(&Px, &Py, X1, Y1, X2, Y2, color, tolerance)){
			continue
		}
		else{
			return false
		}
	}
	return true
}
;ITEM SEARCH FUNCTION
